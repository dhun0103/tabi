# 이 파일을 .env.local 로 복사해서 채우면 됩니다 (.env.local 은 git에 올라가지 않음).

# ── 일행 공유 (Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹) 의 firebaseConfig) ──
# 비워 두면 "이 기기에만 저장" 모드
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── 구글 지도·장소 검색 (Google Cloud 콘솔 > API 및 서비스 > 사용자 인증 정보) ──
# 키에는 "웹사이트 제한(localhost, 배포 주소)"과 "API 제한(Maps JavaScript API, Places API (New))"을 꼭 걸 것
# 비워 두면 무료 지도(국토지리원) + 무료 검색(OpenStreetMap)
VITE_GOOGLE_MAPS_API_KEY=
# 지도 ID (Google Cloud 콘솔 > 지도 관리). 비워 두면 테스트용 DEMO_MAP_ID
VITE_GOOGLE_MAP_ID=
