rules_version = '2';

// 로그인 없이 "링크를 아는 사람만" 쓰는 구조
// - 여행 ID(공유 링크 안의 20자 랜덤 문자열)를 알아야만 읽기/쓰기 가능
// - 전체 여행 목록 조회(list)와 여행 삭제는 막음
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      allow get, create, update: if tripId.size() >= 20;
      allow list, delete: if false;

      match /plans/{planId} {
        allow read, write: if tripId.size() >= 20;
      }
      match /expenses/{expenseId} {
        allow read, write: if tripId.size() >= 20;
      }
      // 장소 사진 (줄인 JPEG를 문서에 그대로)
      match /photos/{photoId} {
        allow read, write: if tripId.size() >= 20;
      }
      // 내 지출 (이 폰에만 보이는 개인 지출): 그 폰만 아는 20자 열쇠 아래에 둠
      // → 일행 폰은 열쇠를 몰라서 못 읽음 (열쇠 목록 조회는 문서가 없어서 불가)
      match /personal/{ownerKey}/expenses/{expenseId} {
        allow read, write: if tripId.size() >= 20 && ownerKey.size() >= 20;
      }
    }
  }
}
